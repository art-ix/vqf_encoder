<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Official SDK .vcxproj files pin toolset v142. Force the host default
       (v143 on VS 2022, v145 on VS 2026). CI also passes a matching VCToolsVersion. -->
  <PropertyGroup>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
  </PropertyGroup>
</Project>
