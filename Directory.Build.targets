<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Official SDK .vcxproj files pin toolset v142 and VCToolsVersion 14.29.
       Force the host default (v143 / v145) and drop the pinned MSVC version so
       VS 2022/2026 CI can build pfc and foobar2000_SDK. -->
  <PropertyGroup>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <VCToolsVersion></VCToolsVersion>
  </PropertyGroup>
</Project>
