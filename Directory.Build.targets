<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Official SDK .vcxproj files still request toolset v142. Force the host default
       (v143 on VS 2022, v145 on VS 2026) so CI and local builds work. -->
  <PropertyGroup>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
  </PropertyGroup>
</Project>
