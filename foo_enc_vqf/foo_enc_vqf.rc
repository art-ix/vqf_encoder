#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_CONVERT DIALOGEX 0, 0, 280, 128
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TwinVQ / VQF"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Output format",-1,12,10,80,10
    LTEXT           "TwinVQ / VQF (native encoder in this component)",IDC_FORMAT,12,22,256,10
    LTEXT           "Bitrate (total kbps)",-1,12,40,110,10
    COMBOBOX        IDC_BITRATE,130,38,80,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Destination",-1,12,62,80,10
    CONTROL         "Same folder as source",IDC_DEST_SAME,"Button",BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,12,76,200,12
    CONTROL         "Choose folder...",IDC_DEST_ASK,"Button",BS_AUTORADIOBUTTON,12,90,200,12
    DEFPUSHBUTTON   "Convert",IDOK,164,108,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,218,108,50,14
END
