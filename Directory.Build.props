<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <!-- Official foobar2000 SDK extracted as ./sdk (not shipped in this repository). -->
    <FOOBAR2000_SDK Condition="'$(FOOBAR2000_SDK)' == ''">$(MSBuildThisFileDirectory)sdk</FOOBAR2000_SDK>
  </PropertyGroup>
</Project>
